function image_(folder,p,n){const it=DriveApp.getFoldersByName(folder),f=it.hasNext()?it.next():DriveApp.createFolder(folder),file=f.createFile(Utilities.newBlob(Utilities.base64Decode(p.imageBase64),p.imageType||'image/jpeg',p.imageName||n));file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return file}function thumb_(id){return'https://drive.google.com/thumbnail?id='+encodeURIComponent(id)+'&sz=w1600'}function sheet_(n){const s=SpreadsheetApp.openById(CFG.SPREADSHEET_ID).getSheetByName(n);if(!s)throw Error(n+' bulunamadı');return s}function ensure_(n,h){const ss=SpreadsheetApp.openById(CFG.SPREADSHEET_ID);let s=ss.getSheetByName(n);if(!s){s=ss.insertSheet(n);s.appendRow(h)}return s}function table_(s){const r=s.getLastRow(),c=s.getLastColumn();if(!r||!c)return{h:[],r:[]};const v=s.getRange(1,1,r,c).getDisplayValues();return{h:v[0],r:v.slice(1).filter(x=>x.some(y=>String(y).trim()))}}function obj_(h,r){const o={};h.forEach((x,i)=>o[x]=r[i]);return o}function c_(v){return String(v||'').toLocaleLowerCase('tr').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/ı/g,'i').replace(/[^a-z0-9]+/g,' ').trim()}function n_(v){return c_(v)}function col_(h,a){for(const x of a){const i=h.indexOf(c_(x));if(i>=0)return i}return-1}function yes_(v){return['evet','true','1','aktif'].includes(n_(v))}function out_(d,cb){const j=JSON.stringify(d),ok=/^[A-Za-z_$][\w$]*$/.test(cb);return ContentService.createTextOutput(ok?cb+'('+j+');':j).setMimeType(ok?ContentService.MimeType.JAVASCRIPT:ContentService.MimeType.JSON)}function frame_(d,s){d.source=s;return HtmlService.createHtmlOutput('<script>parent.postMessage('+JSON.stringify(d)+',"*");</script>')}
