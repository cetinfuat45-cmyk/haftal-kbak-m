'use strict';
const CFG={SPREADSHEET_ID:'1J-4mdyEHUpytO7RNjp2q3dR6xCOszTGTpaWuN-MpxiQ',USER:'veri',MACHINES:'mak-list',TEMPLATES:'weeklyMaintenanceTemplates',RECORDS:'weeklyMaintenanceRecords',REF_FOLDER:'Haftalik_Bakim_Referans_Resimleri',PROOF_FOLDER:'Haftalik_Bakim_Kanit_Resimleri',VERSION:'5.4.1'};
const TEMPLATE_HEADERS=['TemplateID','MachineID','MachineName','CostCenter','Region','System','Part','Task','TargetValue','OrderNo','PhotoRequired','ReferenceImageUrl','ReferenceImageName','ReferenceImageDriveId','Active','CreatedAt','UpdatedAt'];
function doGet(e){const cb=e&&e.parameter?e.parameter.callback:'';try{const a=norm_(e&&e.parameter?e.parameter.action:'health');let r;if(!a||a==='health')r=health_();else if(a==='login')r=login_(e.parameter.password);else if(a==='listmachines')r=listMachines_();else if(a==='listmaintenancetemplates')r=listTemplates_(e.parameter.machineId||'');else if(a==='updatemaintenancetemplate')r=updateTemplate_(e.parameter.payload);else if(a==='deletemaintenancetemplate')r=deleteTemplate_(e.parameter.templateId);else r={success:false,message:'Geçersiz işlem: '+a};return response_(r,cb)}catch(x){return response_({success:false,message:x.message||'Sistem hatası'},cb)}}
function doPost(e){try{const a=norm_(e.parameter.action);if(a==='createmaintenancetemplatewithimage')return frame_(createTemplateWithImage_(e.parameter),'CMMS_APPS_SCRIPT');if(a==='savemaintenanceresultwithimage')return frame_(saveResultWithImage_(e.parameter),'CMMS_APPS_SCRIPT_RESULT');return frame_({success:false,message:'Geçersiz işlem'},'CMMS_APPS_SCRIPT')}catch(x){return frame_({success:false,message:x.message||'Sistem hatası'},'CMMS_APPS_SCRIPT')}}
function health_(){return{success:true,application:'Haftalık Bakım CMMS',version:CFG.VERSION,status:'ACTIVE',machineRows:table_(sheet_(CFG.MACHINES)).rows.length,templateRows:table_(templateSheet_()).rows.length}}
function login_(password){const p=String(password||'').trim(),t=table_(sheet_(CFG.USER)),h=t.headers.map(canon_),name=col_(h,['op isimleri','op isileri','operator','operator adi']),pin=col_(h,['sifre','pin']),role=col_(h,['yetki','rol']),mail=col_(h,['mail adresi','mail','eposta']);if(name<0||pin<0||role<0)throw Error('veri sayfası başlıkları eksik');for(const row of t.rows)if(String(row[pin]||'').trim()===p)return{success:true,user:{operator:String(row[name]||''),role:String(row[role]||''),email:mail<0?'':String(row[mail]||'')}};return{success:false,message:'Şifre hatalı veya kullanıcı bulunamadı.'}}
function listMachines_(){const t=table_(sheet_(CFG.MACHINES)),h=t.headers.map(canon_),id=col_(h,['id','makine id']),name=col_(h,['makine adi']),cost=col_(h,['maliyet mer','maliyet merkezi']);if(id<0||name<0||cost<0)throw Error('mak-list başlıkları eksik');const machines=t.rows.map(r=>({id:String(r[id]||'').trim(),machineName:String(r[name]||'').trim(),costCenter:String(r[cost]||'').trim()})).filter(x=>x.id&&x.machineName);machines.sort((a,b)=>a.machineName.localeCompare(b.machineName,'tr'));return{success:true,count:machines.length,machines}}
function createTemplateWithImage_(p){if(!p.payload||!p.imageBase64)throw Error('Referans resim zorunludur.');const d=JSON.parse(p.payload),machine=listMachines_().machines.find(x=>x.id===String(d.machineId||'').trim());if(!machine)throw Error('Makine bulunamadı.');const file=createImage_(CFG.REF_FOLDER,p,'referans.jpg'),url=thumb_(file.getId()),id='TMP-'+Utilities.getUuid().substring(0,8).toUpperCase();append_(templateSheet_(),{TemplateID:id,MachineID:machine.id,MachineName:machine.machineName,CostCenter:machine.costCenter,Region:String(d.region||'').trim(),System:String(d.system||'').trim(),Part:String(d.part||'').trim(),Task:String(d.task||'').trim(),TargetValue:String(d.targetValue||'').trim(),OrderNo:Number(d.orderNo)||1,PhotoRequired:d.photoRequired?'EVET':'HAYIR',ReferenceImageUrl:url,ReferenceImageName:file.getName(),ReferenceImageDriveId:file.getId(),Active:d.active===false?'HAYIR':'EVET',CreatedAt:new Date(),UpdatedAt:new Date()});return{success:true,templateId:id,referenceImageUrl:url}}
function updateTemplate_(payload){const d=JSON.parse(payload||'{}'),id=String(d.templateId||'').trim(),machine=listMachines_().machines.find(x=>x.id===String(d.machineId||'').trim());if(!id||!machine)throw Error('Bakım veya makine bulunamadı.');const sh=templateSheet_(),t=table_(sh),idCol=t.headers.indexOf('TemplateID'),i=t.rows.findIndex(r=>String(r[idCol]||'').trim()===id);if(i<0)throw Error('Bakım tanımı bulunamadı.');updateRow_(sh,t.headers,i+2,{MachineID:machine.id,MachineName:machine.machineName,CostCenter:machine.costCenter,Region:String(d.region||'').trim(),System:String(d.system||'').trim(),Part:String(d.part||'').trim(),Task:String(d.task||'').trim(),TargetValue:String(d.targetValue||'').trim(),OrderNo:Number(d.orderNo)||1,PhotoRequired:d.photoRequired?'EVET':'HAYIR',Active:d.active===false?'HAYIR':'EVET',UpdatedAt:new Date()});return{success:true,templateId:id}}
function deleteTemplate_(id){const sh=templateSheet_(),t=table_(sh),c=t.headers.indexOf('TemplateID'),i=t.rows.findIndex(r=>String(r[c]||'').trim()===String(id||'').trim());if(i<0)throw Error('Bakım tanımı bulunamadı.');sh.deleteRow(i+2);return{success:true,templateId:id}}
function listTemplates_(machineId){const t=table_(templateSheet_());let templates=t.rows.map(r=>{const o=obj_(t.headers,r),did=String(o.ReferenceImageDriveId||'').trim();return{templateId:o.TemplateID,machineId:o.MachineID,machineName:o.MachineName,costCenter:o.CostCenter,region:o.Region,system:o.System,part:o.Part,task:o.Task,targetValue:o.TargetValue,orderNo:Number(o.OrderNo||1),photoRequired:yes_(o.PhotoRequired),referenceImageUrl:did?thumb_(did):String(o.ReferenceImageUrl||''),referenceImageDriveId:did,active:yes_(o.Active)}});if(machineId)templates=templates.filter(x=>x.machineId===machineId);templates.sort((a,b)=>(a.orderNo||1)-(b.orderNo||1));return{success:true,count:templates.length,templates}}
function saveResultWithImage_(p){if(!p.payload)throw Error('Kontrol verisi bulunamadı.');const d=JSON.parse(p.payload),headers=['RecordID','TemplateID','MachineID','MachineName','Operator','Result','MeasuredValue','Description','Priority','ProofImageUrl','ProofImageName','ProofImageDriveId','WeekKey','CreatedAt'],sh=recordsSheet_(headers);let url='',name='',id='';if(p.imageBase64){const file=createImage_(CFG.PROOF_FOLDER,p,'kanit.jpg');id=file.getId();name=file.getName();url=thumb_(id)}const recordId='REC-'+Utilities.getUuid().substring(0,8).toUpperCase();sh.appendRow([recordId,d.templateId||'',d.machineId||'',d.machineName||'',d.operator||'',d.result||'',d.measuredValue||'',d.description||'',d.priority||'',url,name,id,d.weekKey||'',new Date()]);return{success:true,recordId}}
function createImage_(folderName,p,defaultName){const folder=folder_(folderName),file=folder.createFile(Utilities.newBlob(Utilities.base64Decode(p.imageBase64),p.imageType||'image/jpeg',p.imageName||defaultName));file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return file}function thumb_(id){return'https://drive.google.com/thumbnail?id='+encodeURIComponent(id)+'&sz=w1600'}function folder_(name){const i=DriveApp.getFoldersByName(name);return i.hasNext()?i.next():DriveApp.createFolder(name)}
function templateSheet_(){return ensureSheet_(CFG.TEMPLATES,TEMPLATE_HEADERS)}function recordsSheet_(h){return ensureSheet_(CFG.RECORDS,h)}function ensureSheet_(name,h){const ss=SpreadsheetApp.openById(CFG.SPREADSHEET_ID);let sh=ss.getSheetByName(name);if(!sh){sh=ss.insertSheet(name);sh.appendRow(h)}else{const headers=sh.getRange(1,1,1,Math.max(1,sh.getLastColumn())).getDisplayValues()[0];h.forEach(x=>{if(!headers.includes(x)){sh.getRange(1,sh.getLastColumn()+1).setValue(x);headers.push(x)}})}return sh}function sheet_(n){const s=SpreadsheetApp.openById(CFG.SPREADSHEET_ID).getSheetByName(n);if(!s)throw Error(n+' bulunamadı');return s}function table_(s){const v=s.getDataRange().getDisplayValues();return{headers:v[0]||[],rows:v.slice(1).filter(r=>r.some(x=>String(x).trim()))}}function append_(s,o){const h=s.getRange(1,1,1,s.getLastColumn()).getDisplayValues()[0];s.appendRow(h.map(x=>o[x]??''))}function updateRow_(s,h,row,u){const v=s.getRange(row,1,1,h.length).getValues()[0];Object.keys(u).forEach(k=>{const i=h.indexOf(k);if(i>=0)v[i]=u[k]});s.getRange(row,1,1,h.length).setValues([v])}function obj_(h,r){const o={};h.forEach((x,i)=>o[x]=r[i]);return o}function canon_(v){return String(v||'').toLocaleLowerCase('tr').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/ı/g,'i').replace(/[^a-z0-9]+/g,' ').trim()}function norm_(v){return canon_(v)}function col_(h,a){for(const x of a){const i=h.indexOf(canon_(x));if(i>=0)return i}return-1}function yes_(v){return['evet','true','1','aktif'].includes(norm_(v))}function response_(d,cb){const j=JSON.stringify(d),ok=/^[A-Za-z_$][\w$]*$/.test(cb);return ContentService.createTextOutput(ok?cb+'('+j+');':j).setMimeType(ok?ContentService.MimeType.JAVASCRIPT:ContentService.MimeType.JSON)}function frame_(d,source){d.source=source;return HtmlService.createHtmlOutput('<script>parent.postMessage('+JSON.stringify(d)+',"*");</script>')}
