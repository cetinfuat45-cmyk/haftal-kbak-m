function login_(password){const t=table_(sheet_(CFG.USER)),h=t.h.map(c_),ni=col_(h,['op isimleri','operator','operator adi']),pi=col_(h,['sifre','pin']),ri=col_(h,['yetki','rol']),mi=col_(h,['mail adresi','mail','eposta']);for(const r of t.r)if(String(r[pi]||'').trim()===String(password||'').trim())return{success:true,user:{operator:r[ni],role:r[ri],email:mi<0?'':r[mi]}};return{success:false,message:'Şifre hatalı veya kullanıcı bulunamadı.'}}function machines_(){const t=table_(sheet_(CFG.MACHINES)),h=t.h.map(c_),ii=col_(h,['id','makine id']),ni=col_(h,['makine adi']),ci=col_(h,['maliyet mer','maliyet merkezi']),machines=t.r.map(r=>({id:String(r[ii]||'').trim(),machineName:String(r[ni]||'').trim(),costCenter:String(r[ci]||'').trim()})).filter(x=>x.id&&x.machineName).sort((a,b)=>a.machineName.localeCompare(b.machineName,'tr'));return{success:true,count:machines.length,machines}}function templates_(machineId){const t=table_(ensure_(CFG.TEMPLATES,TH));let templates=t.r.map(r=>{const o=obj_(t.h,r),id=String(o.ReferenceImageDriveId||'');return{templateId:o.TemplateID,machineId:o.MachineID,machineName:o.MachineName,costCenter:o.CostCenter,region:o.Region,system:o.System,part:o.Part,task:o.Task,targetValue:o.TargetValue,orderNo:Number(o.OrderNo||1),photoRequired:yes_(o.PhotoRequired),referenceImageUrl:id?thumb_(id):o.ReferenceImageUrl||'',referenceImageDriveId:id,active:yes_(o.Active)}});if(machineId)templates=templates.filter(x=>x.machineId===machineId);return{success:true,count:templates.length,templates}}function bootstrap_(){const all=templates_('').templates.filter(x=>x.active),ids=new Set(all.map(x=>x.machineId)),machines=machines_().machines.filter(x=>ids.has(x.id)),templatesByMachine={};all.forEach(x=>(templatesByMachine[x.machineId]||(templatesByMachine[x.machineId]=[])).push(x));return{success:true,source:'sheet',machines,templatesByMachine,templateCount:all.length,generatedAt:new Date().toISOString()}}
